{
  "name": "sofa2slugger",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "dependencies": {},
  "scripts": {
    "dev": "npm run dev --workspace web -- --hostname 127.0.0.1 --port 3000",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm run test -w web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "ship": "bash scripts/ship.sh"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "prettier": "^3.0.0",
    "vitest": "^4.0.18"
  }
}
